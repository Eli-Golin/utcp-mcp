{
  "name": "@utcp/mcp-bridge",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server to use Universal Tool Calling Protocol (UTCP)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-bridge": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev:register": "node scripts/dev-register.mjs",
    "dev:unregister": "node scripts/dev-unregister.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "utcp",
    "mcp",
    "model-context-protocol",
    "universal-tool-calling-protocol",
    "bridge",
    "tools",
    "ai"
  ],
  "author": "UTCP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/universal-tool-calling-protocol/utcp-mcp.git"
  },
  "homepage": "https://github.com/universal-tool-calling-protocol/utcp-mcp#readme",
  "bugs": {
    "url": "https://github.com/universal-tool-calling-protocol/utcp-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.20.2",
    "@utcp/cli": "file:../typescript-utcp/packages/cli",
    "@utcp/http": "file:../typescript-utcp/packages/http",
    "@utcp/mcp": "file:../typescript-utcp/packages/mcp",
    "@utcp/sdk": "file:../typescript-utcp/packages/core",
    "@utcp/text": "file:../typescript-utcp/packages/text",
    "@utcp/dotenv-loader": "file:../typescript-utcp/packages/dotenv-loader",
    "@utcp/file": "file:../typescript-utcp/packages/file",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0"
  }
}
