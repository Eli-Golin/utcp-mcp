{
  "name": "@eli-golin/utcp-mcp-bridge",
  "version": "1.1.1",
  "description": "Model Context Protocol (MCP) server to use Universal Tool Calling Protocol (UTCP) (maintained fork)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-bridge": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev:register": "node scripts/dev-register.mjs",
    "dev:unregister": "node scripts/dev-unregister.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "utcp",
    "mcp",
    "model-context-protocol",
    "universal-tool-calling-protocol",
    "bridge",
    "tools",
    "ai"
  ],
  "author": "Eli Golin (fork of the work by the UTCP Team)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eli-Golin/utcp-mcp.git"
  },
  "homepage": "https://github.com/Eli-Golin/utcp-mcp#readme",
  "bugs": {
    "url": "https://github.com/Eli-Golin/utcp-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@eli-golin/utcp-cli": "^1.1.4",
    "@eli-golin/utcp-dotenv-loader": "^1.1.1",
    "@eli-golin/utcp-file": "^1.1.1",
    "@eli-golin/utcp-http": "^1.1.15",
    "@eli-golin/utcp-mcp": "^1.2.1",
    "@eli-golin/utcp-sdk": "^1.2.1",
    "@eli-golin/utcp-text": "^1.1.1",
    "@modelcontextprotocol/sdk": "~1.20.2",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0"
  }
}
